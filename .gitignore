# Node artifact files
node_modules/
dist/
static/hello-world/build-check/
static/hello-world/build-codex-verify*/
static/hello-world/build-fast-inventory-fix/
static/hello-world/build-space-labels-fix/
static/hello-world/build-space-taxonomy-fix/
static/hello-world/build-action-feedback-fix/
static/hello-world/build-message-polish-fix/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


/.forge/
